#!/usr/bin/env bash
# Start marketing (Next) + app (Vite) together for local split-stack development.
#
# Writes .env.local in each app so cross-origin links use these localhost ports:
#   frontend/marketing/.env.local  → NEXT_PUBLIC_APP_ORIGIN
#   frontend/webapp/.env.local        → VITE_MARKETING_ORIGIN (+ mirrors API URLs from marketing .env)
#
# Usage (from repo root):
#   ./scripts/dev-web
#   MARKETING_PORT=3000 APP_PORT=5173 ./scripts/dev-web
#   npm run dev:web
#
# Prod remains consciously.live + app.consciously.live — this script is local only.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MARKETING_DIR="$REPO_ROOT/frontend/marketing"
APP_DIR="$REPO_ROOT/frontend/webapp"

MARKETING_PORT="${MARKETING_PORT:-3000}"
APP_PORT="${APP_PORT:-5173}"
MARKETING_ORIGIN="http://localhost:${MARKETING_PORT}"
APP_ORIGIN="http://localhost:${APP_PORT}"

MARKETING_ENV_LOCAL="$MARKETING_DIR/.env.local"
APP_ENV_LOCAL="$APP_DIR/.env.local"
MARKETING_ENV="$MARKETING_DIR/.env"

if [[ ! -d "$MARKETING_DIR" || ! -d "$APP_DIR" ]]; then
  echo "error: expected frontend/marketing and frontend/webapp under $REPO_ROOT" >&2
  exit 1
fi

if [[ ! -f "$MARKETING_ENV" ]]; then
  echo "error: missing $MARKETING_ENV — copy from .env.example and fill NEXT_PUBLIC_MEDIMADE_API_URL." >&2
  exit 1
fi

# Load marketing .env so we can mirror API URLs into the SPA .env.local
set -a
# shellcheck disable=SC1090
source "$MARKETING_ENV"
set +a

if [[ -z "${NEXT_PUBLIC_MEDIMADE_API_URL:-}" ]]; then
  echo "error: NEXT_PUBLIC_MEDIMADE_API_URL is unset in $MARKETING_ENV" >&2
  exit 1
fi

write_marketing_env_local() {
  cat >"$MARKETING_ENV_LOCAL" <<EOF
# Generated by scripts/dev-web — local only (gitignored).
# Points Focus / SPA redirects at the Vite dev server.
NEXT_PUBLIC_APP_ORIGIN=${APP_ORIGIN}
EOF
}

write_app_env_local() {
  cat >"$APP_ENV_LOCAL" <<EOF
# Generated by scripts/dev-web — local only (gitignored).
# Mirrors API URLs from frontend/marketing/.env and points login/marketing links at Next.
VITE_MEDIMADE_API_URL=${NEXT_PUBLIC_MEDIMADE_API_URL}
VITE_MEDIMADE_MEDIA_BASE_URL=${NEXT_PUBLIC_MEDIMADE_MEDIA_BASE_URL:-}
VITE_MEDIMADE_CHAT_URL=${NEXT_PUBLIC_MEDIMADE_CHAT_URL:-}
VITE_ASSISTANT_CHAT_URL=${NEXT_PUBLIC_ASSISTANT_CHAT_URL:-}
VITE_MEDIMADE_SCRIPT_LAB_URL=${NEXT_PUBLIC_MEDIMADE_SCRIPT_LAB_URL:-}
VITE_MARKETING_ORIGIN=${MARKETING_ORIGIN}
EOF
}

write_marketing_env_local
write_app_env_local

echo "Local split-stack origins:"
echo "  marketing  ${MARKETING_ORIGIN}  (Next)"
echo "  app        ${APP_ORIGIN}  (Vite)"
echo "Wrote:"
echo "  ${MARKETING_ENV_LOCAL}"
echo "  ${APP_ENV_LOCAL}"
echo ""

PIDS=()

cleanup() {
  local pid
  for pid in "${PIDS[@]:-}"; do
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
  done
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Next.js
(
  cd "$MARKETING_DIR"
  exec npm run dev -- -p "$MARKETING_PORT"
) &
PIDS+=($!)

# Vite (workspace)
(
  cd "$REPO_ROOT"
  exec npm run dev -w @consciously/webapp -- --port "$APP_PORT" --strictPort
) &
PIDS+=($!)

echo "Started both dev servers (Ctrl+C stops both)."
echo "  Marketing: ${MARKETING_ORIGIN}"
echo "  App:       ${APP_ORIGIN}"
echo ""

# Bash 3.2 (macOS) has no `wait -n` — poll until one child exits.
while kill -0 "${PIDS[0]}" 2>/dev/null && kill -0 "${PIDS[1]}" 2>/dev/null; do
  sleep 1
done

EXIT_CODE=0
for pid in "${PIDS[@]}"; do
  if ! kill -0 "$pid" 2>/dev/null; then
    wait "$pid" || EXIT_CODE=$?
  fi
done
echo "A dev server exited (code ${EXIT_CODE}); shutting down the rest."
exit "$EXIT_CODE"
