#!/usr/bin/env bash
# Deploy CDK stack and sync stack outputs into:
#   frontend/marketing/.env — NEXT_PUBLIC_MEDIMADE_* (Next.js)
#   frontend/webapp/.env    — VITE_MEDIMADE_* (Vite SPA)
#   frontend/mobile/.env    — EXPO_PUBLIC_MEDIMADE_* (Expo)
#   frontend/extension/.env — VITE_MEDIMADE_* (Chrome extension)
# Usage (from anywhere):
#   backend/scripts/deploy-back
#   backend/scripts/deploy-back --profile mm
#   backend/scripts/deploy-back ConsciouslyBackend --require-approval never --profile mm
#   backend/scripts/deploy-back MedimadeBackend --require-approval never   # legacy only
#
# Defaults to ConsciouslyBackend (live). Primary region is London (eu-west-2).
# AWS profile: defaults to AWS_PROFILE=mm when unset and no --profile in arguments.
set -euo pipefail

BACKEND_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPT_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/lib" && pwd)"
# shellcheck source=lib/default-aws-profile.sh
source "$SCRIPT_LIB/default-aws-profile.sh"
medimade_default_aws_profile "$@"

# Pin London unless the caller already set a region explicitly.
export CDK_DEFAULT_REGION="${CDK_DEFAULT_REGION:-eu-west-2}"
export AWS_REGION="${AWS_REGION:-$CDK_DEFAULT_REGION}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-$CDK_DEFAULT_REGION}"

REPO_ROOT="$(cd "$BACKEND_ROOT/.." && pwd)"
MARKETING_ENV="$REPO_ROOT/frontend/marketing/.env"
WEBAPP_ENV="$REPO_ROOT/frontend/webapp/.env"
MOBILE_ENV="$REPO_ROOT/frontend/mobile/.env"
EXT_ENV="$REPO_ROOT/frontend/extension/.env"
OUTPUTS="$(mktemp)"
cleanup() { rm -f "$OUTPUTS"; }
trap cleanup EXIT

cd "$BACKEND_ROOT"

extra_args=()

# Auth (magic-link) deploy-time context.
# Provide these as env vars so deploys work like other helper scripts.
# - MEDIMADE_AUTH_EMAIL_FROM: sender email (must be allowed in Brevo)
# - MEDIMADE_AUTH_WEBAPP_ORIGIN: where the magic-link should send the user (e.g. https://webapp.yourdomain.com)
has_context() {
  local key="$1"
  shift
  local i
  for ((i = 1; i <= $#; i++)); do
    local a="${!i}"
    if [[ "$a" == "-c" ]]; then
      local j=$((i + 1))
      local next="${!j:-}"
      if [[ "$next" == "$key="* ]]; then
        return 0
      fi
    fi
    if [[ "$a" == -c*"$key="* ]]; then
      return 0
    fi
  done
  return 1
}

auth_from="${MEDIMADE_AUTH_EMAIL_FROM:-${AUTH_EMAIL_FROM:-}}"
auth_origin="${MEDIMADE_AUTH_WEBAPP_ORIGIN:-${AUTH_WEBAPP_ORIGIN:-}}"

if [[ -n "${auth_from:-}" ]] && ! has_context "authEmailFrom" "$@"; then
  extra_args+=(-c "authEmailFrom=$auth_from")
fi
if [[ -n "${auth_origin:-}" ]] && ! has_context "authWebappOrigin" "$@"; then
  extra_args+=(-c "authWebappOrigin=$auth_origin")
fi

DEFAULT_STACK="ConsciouslyBackend"

stack_named=0
target_stack=""
skip_next=0
for a in "$@"; do
  if [[ "$skip_next" -eq 1 ]]; then
    skip_next=0
    continue
  fi
  case "$a" in
    --profile | --outputs-file | --require-approval | --app | --context | -c | -o )
      skip_next=1
      ;;
    --profile=* | --outputs-file=* | --require-approval=* | --app=* | --context=* | -c* | -o* )
      ;;
    -* ) ;;
    ConsciouslyBackend | MedimadeBackend )
      stack_named=1
      target_stack="$a"
      break
      ;;
    * )
      stack_named=1
      target_stack="$a"
      break
      ;;
  esac
done

if [[ "$stack_named" -eq 0 ]]; then
  target_stack="$DEFAULT_STACK"
fi

# ConsciouslyBackend is only in the CDK app when enabled via env or context.
if [[ "$target_stack" == "ConsciouslyBackend" ]]; then
  export CONSCIOUSLY_STACK=1
  if ! has_context "consciouslyStack" "$@"; then
    extra_args+=(-c "consciouslyStack=true")
  fi
fi

echo "Deploying ${target_stack} to region ${CDK_DEFAULT_REGION} (profile ${AWS_PROFILE:-default})"

if ((${#extra_args[@]})); then
  if [[ "$stack_named" -eq 0 ]]; then
    npx cdk deploy "$DEFAULT_STACK" "${extra_args[@]}" "$@" --outputs-file "$OUTPUTS"
  else
    npx cdk deploy "${extra_args[@]}" "$@" --outputs-file "$OUTPUTS"
  fi
else
  if [[ "$stack_named" -eq 0 ]]; then
    npx cdk deploy "$DEFAULT_STACK" "$@" --outputs-file "$OUTPUTS"
  else
    npx cdk deploy "$@" --outputs-file "$OUTPUTS"
  fi
fi

node "$BACKEND_ROOT/scripts/write-webapp-env-from-outputs.mjs" \
  "$OUTPUTS" \
  "$MARKETING_ENV" \
  "$MOBILE_ENV" \
  "$EXT_ENV" \
  "$WEBAPP_ENV"
