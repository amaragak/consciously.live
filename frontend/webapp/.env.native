# Native (Capacitor) builds: `vite build --mode native`.
# Loaded after `.env` / `.env.local`, so it wins over the localhost values that
# scripts/dev-web writes into `.env.local`.
#
# API and media URLs come from `.env` (same values as the deployed SPA). To point
# a native build at another API, put overrides in `.env.native.local` (gitignored),
# or create `.env.native-staging.local` and run `npm run build:native:staging`.
VITE_MARKETING_ORIGIN=https://consciously.live
