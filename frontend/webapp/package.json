{
  "name": "@consciously/webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:native": "vite build --mode native",
    "build:native:internal": "VITE_INTERNAL_BUILD=1 vite build --mode native",
    "build:native:staging": "VITE_INTERNAL_BUILD=1 vite build --mode native-staging",
    "native:sync": "npm run build:native && cap sync",
    "native:sync:internal": "npm run build:native:internal && cap sync",
    "native:ios": "npm run native:sync && cap open ios",
    "native:android": "npm run native:sync && cap open android",
    "native:run:ios": "npm run native:sync:internal && cap run ios",
    "native:run:android": "npm run native:sync:internal && cap run android",
    "native:dev:ios": "node scripts/native-dev.mjs ios",
    "native:dev:android": "node scripts/native-dev.mjs android",
    "native:assets": "capacitor-assets generate --ios --android --assetPath native-assets --iconBackgroundColor '#1E232E' --iconBackgroundColorDark '#1E232E' --splashBackgroundColor '#1E232E' --splashBackgroundColorDark '#1E232E'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@consciously/common": "*",
    "@mediagrid/capacitor-native-audio": "^3.0.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xyflow/react": "^12.12.0",
    "exifr": "^7.1.3",
    "heic-to": "^1.5.2",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "lucide-react": "^1.33.0",
    "pdfjs-dist": "^5.6.205",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.6.0",
    "tesseract.js": "^7.0.0",
    "tldraw": "^5.1.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.3.0"
  }
}
