# Base URL from CDK output `ApiUrl` (HTTP API), e.g. https://xxxx.execute-api.eu-west-2.amazonaws.com
# No trailing slash. Used for POST /fish/tts.
NEXT_PUBLIC_MEDIMADE_API_URL=
# Lambda Function URL from CDK output `MedimadeChatUrl` (Claude streaming chat, POST JSON body).
NEXT_PUBLIC_MEDIMADE_CHAT_URL=
# Lambda Function URL from CDK output `AssistantChatUrl` (app-control Chat with prompt caching).
NEXT_PUBLIC_ASSISTANT_CHAT_URL=
# Optional local Anthropic key for `/api/assistant-chat` when AssistantChatUrl is unset (dev only).
# ANTHROPIC_API_KEY=
# Lambda Function URL from CDK output `AdminScriptLabUrl` (Script Lab generate-script, POST JSON body).
NEXT_PUBLIC_MEDIMADE_SCRIPT_LAB_URL=
# Media CDN for MP3s / background audio preview: CDK `MediaCloudFrontDomain` with https://, no trailing slash.
NEXT_PUBLIC_MEDIMADE_MEDIA_BASE_URL=
# Vite SPA origin (Focus and other migrated logged-in surfaces).
# Local: scripts/dev-web writes frontend/marketing/.env.local with http://localhost:5173
NEXT_PUBLIC_APP_ORIGIN=https://app.consciously.live
# Cognito (optional password/passkey/social — from CDK Cognito* outputs after deploy-back).
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=
# NEXT_PUBLIC_COGNITO_DOMAIN=prefix.auth.eu-west-2.amazoncognito.com
# NEXT_PUBLIC_COGNITO_ISSUER=

