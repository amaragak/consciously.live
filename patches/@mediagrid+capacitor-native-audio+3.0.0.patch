+    /// After the notification source ends, keep followers going, then fade them
+    /// out natively. The web view may be suspended in the background by now.
+    func startOutro(holdSeconds: Double, fadeSeconds: Double) {
+        cancelOutro()
+
+        let followers = audioSources.followers()
+        if followers.isEmpty {
+            return
+        }
+
+        let total = max(0, holdSeconds) + max(0, fadeSeconds)
+        if total <= 0 {
+            followers.forEach { $0.pause() }
+            return
+        }
+
+        var base: [String: Float] = [:]
+        for follower in followers {
+            base[follower.id] = follower.getVolume()
+        }
+        outroBaseVolumes = base
+
+        let startedAt = Date()
+        outroTimer = Timer.scheduledTimer(withTimeInterval: 0.1, repeats: true) {
+            [weak self] timer in
+            guard let self else {
+                timer.invalidate()
+                return
+            }
+
+            let into = Date().timeIntervalSince(startedAt)
+            if into >= total {
+                self.finishOutro()
+                return
+            }
+
+            var gain: Float = 1
+            if into > holdSeconds && fadeSeconds > 0 {
+                let t = min(1, (into - holdSeconds) / fadeSeconds)
+                gain = Float(cos(t * Double.pi / 2))
+            }
+
+            for follower in self.audioSources.followers() {
+                let volume = self.outroBaseVolumes[follower.id] ?? 1
+                follower.setVolume(volume: volume * gain)
+            }
+        }
+    }
+
+    func cancelOutro() {
+        guard let timer = outroTimer else {
+            return
+        }
+
+        timer.invalidate()
+        outroTimer = nil
+
+        for follower in audioSources.followers() {
+            if let volume = outroBaseVolumes[follower.id] {
+                follower.setVolume(volume: volume)
+            }
+        }
+        outroBaseVolumes = [:]
+    }
+
+    private func finishOutro() {
+        outroTimer?.invalidate()
+        outroTimer = nil
+
+        for follower in audioSources.followers() {
+            follower.pause()
+            if let volume = outroBaseVolumes[follower.id] {
+                follower.setVolume(volume: volume)
+            }
+        }
+        outroBaseVolumes = [:]
+    }
